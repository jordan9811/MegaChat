# ─── Tempo mainnet (eip155:4217) — current chain for the tempo-mainnet branch ─
# Copy this file to `.env` and fill in your wallet addresses.
# REAL MAINNET = REAL MONEY. Keep prices at dust levels while testing.
# The ARC_* / CIRCLE_* vars further down are legacy (Arc branches) — keep them.

TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_CHAIN_ID=4217
# USDC.e (Stargate-bridged USDC) on Tempo mainnet, 6 decimals
TEMPO_USDC_ADDRESS=0x20c000000000000000000000b9537d11c60e8b50
TEMPO_EXPLORER_URL=https://explore.tempo.xyz

# Privy embedded wallets (email/social/passkey login) — from dashboard.privy.io
# App id is public (shipped to the browser); the secret must stay server-side.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── MPP session meter (TIP-1034 channels) ────────────────────────────────────
# Binds payment challenges to their contents (any hex string; random per boot
# if unset — restarts then void in-flight challenges only, never channels).
MPP_SECRET_KEY=
# Reserved from the viewer balance so the channel open/close txs stay payable
# (Tempo fees come out of the same stablecoin; learned on mainnet).
MPP_FEE_HEADROOM=0.02
# Kick a live seat when no PAID tick arrives for this long (ms).
MPP_STALE_MS=20000

# ─── Legacy: Arc Testnet (eip155:5042002) — Circle Gateway payment rail ───────

# Arc Testnet RPC + chain
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# USDC (ERC-20 interface) on Arc Testnet, 6 decimals
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Gateway Wallet deposit contract (where buyers deposit USDC)
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# Circle Gateway facilitator (testnet) — verifies + settles payments
FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Block explorer + faucet (reference only)
EXPLORER_URL=https://testnet.arcscan.app
# Faucet: https://faucet.circle.com  (select Arc Testnet)

# Seller wallet that receives seat payments (REQUIRED — set to your address)
SELLER_WALLET_ADDRESS=0xYourSellerWalletHere

# Seller private key — refunds unused MetaMask prepaid USDC on leave, AND pulls
# passkey stream ticks via USDC transferFrom (Phase 2). KEEP SECRET.
SELLER_PRIVATE_KEY=0xYourSellerPrivateKeyHere

# How long a paid-but-not-yet-live seat is held before release+refund (ms).
PENDING_CAMERA_TIMEOUT_MS=300000

# Price per seat, in USDC dollars
SEAT_PRICE=0.01

# ─── Pass B: pay-per-tick meter (MetaMask / Gateway prepaid block) ───────────
TICK_SECONDS=10
TICK_PRICE=0.1
MAX_SESSION=2
# On-camera seats per room, clamped 1-3 (optional)
# MAX_SEATS=3

# ─── Phase 2: passkey stream meter (true per-second on-chain pulls) ──────────
# One upfront approve userOp, then server transferFrom each tick (approach B).
PASSKEY_TICK_SECONDS=1
PASSKEY_TICK_PRICE=0.001

# ─── Pass C: watch-to-earn rewards ───────────────────────────────────────────
EARN_INTERVAL=60
EARN_AMOUNT=0.1
EARN_CAP=5
# Pre-funded pool wallet that pays out rewards (fund from faucet.circle.com)
REWARD_POOL_WALLET_ADDRESS=0xYourRewardPoolWalletHere
# Private key for the reward pool wallet (server-side payouts; KEEP SECRET)
REWARD_POOL_PRIVATE_KEY=0xYourRewardPoolPrivateKeyHere

# Server port
PORT=3000

# Legacy rooms in data/rooms.json without a password get this default (hashed on first boot).
# Change it in .env before first run in production, then set per-room passwords in dashboard.
ROOM_DEFAULT_PASSWORD=changeme

# Public base URL for copy-link buttons (optional)
# BASE_URL=http://localhost:3000

# ─── Phase 1: Circle Modular Wallets (passkey smart accounts on Arc Testnet) ─
# From Circle Console → Modular Wallets. Passkey domain must match where you test
# (e.g. localhost for http://localhost:3000). NEVER commit real keys.
CIRCLE_CLIENT_KEY=TEST_API_KEY:your_client_key_here
CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Arc Testnet path segment for toModularTransport (Circle skill: /arcTestnet)
CIRCLE_MODULAR_CHAIN_PATH=arcTestnet

# Passkey client is bundled for the browser: npm run build:passkey
# (re-run after editing src/passkey-wallet.mjs)

# Contact link in the footer nav (X/Twitter) - shown as "Contact" on the landing page
CONTACT_URL=https://x.com/yourhandle
