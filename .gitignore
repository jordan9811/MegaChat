node_modules/
.env
.env.*
!.env.example
*.log
# Everything under data/ is runtime state: stores, ledgers, OAuth tokens,
# posters. A local run without DATA_DIR writes them here, and a per-file list
# missed sixteen of them (x-tokens.json and settlement.jsonl among them), so
# the whole folder is ignored except the placeholder that keeps it in git.
# The per-file data/ lines below predate this rule and stay for their notes.
data/*
!data/.gitkeep
# The live bounty store: pledges, claims, air sessions, verifications and
# payouts. Same class of runtime state as its neighbours here, but it was
# missing from this list, so an empty skeleton created by importing
# bounty-store.js without DATA_DIR set got committed by accident. Committing it
# from a real deployment would put payout records into git history.
data/bounty.json
data/bounty-evidence.jsonl
data/overlay-visibility.jsonl
data/bounty-ledger.jsonl
data/bounty-captures/
data/rooms.json
data/identities.json
tools/
.next/

# lazy-connect runtime ledger (observability artifact, not source)
data/livekit-sessions.json

# webhook metering state + persistence boot marker (runtime, not source)
data/livekit-webhook-state.json
data/boot-marker.json
data/bounty-clips/

# MegaChat clips held for a mod: paid fan recordings plus their metadata.
# Runtime state on the volume, never source — and a fan's face is the last
# thing that should reach git history.
data/letters/

# Run B synthetic corpus — generated by _corpus-run-b.mjs, never checked in
corpus/

# _probe-pumpfun.mjs output — an observation of a live third-party stream at a
# moment in time, not source. Re-run the probe rather than reading a stale one.
pumpfun-probe.json
pumpfun-probe.png

# Scratch files from interactive sessions — never part of the repo.
_tmp-*

# Go-signal file for --wait-for-go rehearsals; never part of the repo.
_GO

# Screenshots and audit captures dropped at the repo root by agents and
# one-off shot scripts. No PNG at the root is tracked; gate evidence that is
# kept lives in its own folder (join-fix-evidence/, screens/).
/*.png
/audit-*
# Session prompt files. The four already tracked stay tracked; a new one is
# committed on purpose with `git add -f`.
/megachat-*.md

# local browser-testing identity minter — never ships (see the P0 note: it
# forges cookies prod currently honors via the fallback secret)
dev-auth.mjs

# Stale agent worktrees and tool scratch. A `git add -A` in this repo swept
# 1292 files of a .codex-worktrees COPY OF THE REPO into a commit once; these
# three lines are why it cannot happen twice.
.codex-worktrees/
.playwright-mcp/
.claude/worktrees/
