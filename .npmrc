# mppx declares an OPTIONAL peer of express@>=5; this app runs express 4 and
# never touches mppx's express integration (meter-mpp.js adapts requests by
# hand). npm 7+ still hard-fails `npm ci` on the conflict — Railway build
# breaks without this. Proven pairing: all _gate-tempo-*.mjs passed on
# express@4.22.1 + mppx@0.8.6 with real mainnet money.
legacy-peer-deps=true
