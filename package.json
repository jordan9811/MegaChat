{
  "name": "vdo-ninja-stream",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js --prod",
    "build": "npm --prefix web run build",
    "postinstall": "npm --prefix web install",
    "gate:dashboard": "node _gate-dashboard-phase1.mjs",
    "gate:rewards-b": "node _gate-rewards-part-b.mjs",
    "gate:auth": "node _gate-auth.mjs",
    "gate:whitelist": "node _gate-guest-whitelist.mjs",
    "gate:typecheck": "node _gate-typecheck.mjs",
    "docs:summary": "node scripts/docs-summary.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:gitbook-check": "node scripts/docs-gitbook-check.mjs",
    "docs:verify": "node scripts/docs-check.mjs && node scripts/docs-sync.mjs && node scripts/docs-gitbook-check.mjs"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "^1.0.13",
    "@privy-io/server-auth": "^1.32.5",
    "express": "^4.18.2",
    "livekit-server-sdk": "^2.17.0",
    "mppx": "^0.8.6",
    "viem": "^2.54.6",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "puppeteer-core": "^25.3.0",
    "solc": "^0.8.37"
  }
}
